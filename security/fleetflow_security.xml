<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FleetFlow Category -->
        <record id="module_fleetflow" model="ir.module.category">
            <field name="name">FleetFlow</field>
            <field name="description">Fleet &amp; Logistics Management</field>
            <field name="sequence">100</field>
        </record>

        <!-- Fleet Manager -->
        <record id="group_fleetflow_manager" model="res.groups">
            <field name="name">Fleet Manager</field>
            <field name="category_id" ref="module_fleetflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Fleet Managers: Full access to vehicles, trips, maintenance, analytics.</field>
        </record>

        <!-- Dispatcher -->
        <record id="group_fleetflow_dispatcher" model="res.groups">
            <field name="name">Dispatcher</field>
            <field name="category_id" ref="module_fleetflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Dispatchers: Create and manage trips, assign drivers.</field>
        </record>

        <!-- Safety Officer -->
        <record id="group_fleetflow_safety" model="res.groups">
            <field name="name">Safety Officer</field>
            <field name="category_id" ref="module_fleetflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Safety Officers: Monitor driver compliance, licenses, and safety scores.</field>
        </record>

        <!-- Financial Analyst -->
        <record id="group_fleetflow_finance" model="res.groups">
            <field name="name">Financial Analyst</field>
            <field name="category_id" ref="module_fleetflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Financial Analysts: View costs, fuel logs, and analytics reports.</field>
        </record>
    </data>
</odoo>
