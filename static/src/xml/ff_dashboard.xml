<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="fleetflow.Dashboard">
        <div class="ff-dashboard">
            <div class="ff-topbar">
                <div class="ff-topbar-left">
                    <i class="fa fa-bars ff-menu-icon"/>
                    <span class="ff-brand">Fleet Flow</span>
                </div>
                <div class="ff-topbar-center">
                    <input
                        class="ff-search-input"
                        type="text"
                        placeholder="Search trips, vehicles, drivers..."
                        t-att-value="state.searchQuery"
                        t-on-input="onSearchInput"
                    />
                    <select class="ff-select" t-on-change="onFilterFleetType">
                        <option value="all">All Types</option>
                        <option value="truck">Truck</option>
                        <option value="van">Van</option>
                        <option value="bike">Bike</option>
                        <option value="other">Other</option>
                    </select>
                    <select class="ff-select" t-on-change="onFilterStatus">
                        <option value="all">All Status</option>
                        <option value="draft">Draft</option>
                        <option value="dispatched">Dispatched</option>
                        <option value="completed">Completed</option>
                        <option value="cancelled">Cancelled</option>
                    </select>
                    <select class="ff-select" t-on-change="onSortChange">
                        <option value="scheduled_date">Sort: Date</option>
                        <option value="name">Sort: Trip #</option>
                        <option value="state">Sort: Status</option>
                        <option value="cargo_weight">Sort: Cargo</option>
                    </select>
                </div>
                <div class="ff-topbar-right">
                    <button class="ff-btn ff-btn-secondary" t-on-click="onRefresh">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                    <button class="ff-btn ff-btn-primary" t-on-click="onNewTrip">
                        <i class="fa fa-plus"/> New Trip
                    </button>
                    <button class="ff-btn ff-btn-success" t-on-click="onNewVehicle">
                        <i class="fa fa-truck"/> New Vehicle
                    </button>
                </div>
            </div>

            <div class="ff-page-header">
                <div>
                    <h1 class="ff-page-title">Command Center</h1>
                    <p class="ff-page-subtitle">Real-time overview of your fleet operations</p>
                </div>
            </div>

            <div class="ff-kpi-section">
                <div class="ff-kpi-card">
                    <div class="ff-kpi-header">
                        <i class="fa fa-archive"/>
                    </div>
                    <div class="ff-kpi-body">
                        <div class="ff-kpi-label">Pending Cargo</div>
                        <div class="ff-kpi-value" t-esc="state.pendingCargo"/>
                        <div class="ff-kpi-sub">awaiting dispatch</div>
                    </div>
                    <div class="ff-kpi-arrow"><i class="fa fa-chevron-right"/></div>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="ff-loading">
                    <p>Loading dashboard data…</p>
                </div>
            </t>

            <t t-else="">
                <div class="ff-table-container">
                    <table class="ff-table">
                        <thead>
                            <tr>
                                <th class="ff-th-sortable" t-on-click="() => this.onSortColumn('name')">
                                    Trip # <t t-esc="getSortIcon('name')"/>
                                </th>
                                <th>Vehicle</th>
                                <th>Type</th>
                                <th class="ff-th-sortable" t-on-click="() => this.onSortColumn('driver_id')">
                                    Driver <t t-esc="getSortIcon('driver_id')"/>
                                </th>
                                <th>Route</th>
                                <th class="ff-th-sortable" t-on-click="() => this.onSortColumn('scheduled_date')">
                                    Scheduled <t t-esc="getSortIcon('scheduled_date')"/>
                                </th>
                                <th class="ff-th-sortable" t-on-click="() => this.onSortColumn('cargo_weight')">
                                    Cargo (kg) <t t-esc="getSortIcon('cargo_weight')"/>
                                </th>
                                <th class="ff-th-sortable" t-on-click="() => this.onSortColumn('state')">
                                    Status <t t-esc="getSortIcon('state')"/>
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.trips" t-as="trip" t-key="trip.id">
                                <tr class="ff-tr" t-on-click="() => this.onTripClick(trip.id)">
                                    <td class="ff-td-name">
                                        <strong t-esc="trip.name"/>
                                    </td>
                                    <td>
                                        <span class="ff-vehicle-chip">
                                            <i class="fa fa-truck"/>
                                            <t t-esc="trip.vehicle_id and trip.vehicle_id[1] or '—'"/>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="ff-type-chip" t-esc="trip.fleet_type or '—'"/>
                                    </td>
                                    <td>
                                        <span class="ff-driver-chip">
                                            <i class="fa fa-user"/>
                                            <t t-esc="trip.driver_id and trip.driver_id[1] or '—'"/>
                                        </span>
                                    </td>
                                    <td class="ff-td-route">
                                        <t t-if="trip.origin or trip.destination">
                                            <span class="ff-route">
                                                <t t-esc="trip.origin or '?'"/>
                                                <i class="fa fa-long-arrow-right ff-route-arrow"/>
                                                <t t-esc="trip.destination or '?'"/>
                                            </span>
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td class="ff-td-date">
                                        <t t-esc="formatDate(trip.scheduled_date)"/>
                                    </td>
                                    <td class="ff-td-cargo">
                                        <t t-esc="trip.cargo_weight ? trip.cargo_weight.toLocaleString() : '—'"/>
                                    </td>
                                    <td>
                                        <span t-att-class="'ff-badge ' + getStatusBadgeClass(trip.state)">
                                            <t t-esc="getStatusLabel(trip.state)"/>
                                        </span>
                                    </td>
                                    <td t-on-click.stop="">
                                        <button
                                            t-if="trip.state === 'draft'"
                                            class="ff-btn ff-btn-xs ff-btn-primary"
                                            t-on-click="(ev) => this.onDispatch(ev, trip.id)">
                                            Dispatch
                                        </button>
                                        <button
                                            t-elif="trip.state === 'dispatched'"
                                            class="ff-btn ff-btn-xs ff-btn-success"
                                            t-on-click="(ev) => this.onComplete(ev, trip.id)">
                                            Complete
                                        </button>
                                        <span t-else="" class="ff-no-action">—</span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>
</templates>
