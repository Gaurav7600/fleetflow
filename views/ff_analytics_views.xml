<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_ff_analytics_client" model="ir.actions.client">
        <field name="name">Analytics GAURAV &amp; Financial Reports</field>
        <field name="tag">fleetflow_analytics</field>
    </record>

    <record id="view_ff_vehicle_pivot" model="ir.ui.view">
        <field name="name">ff.vehicle.analytics.pivot</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Fleet Financial Summary" sample="1" disable_linking="0">
                <field name="vehicle_type" type="row"/>
                <field name="name" type="row"/>
                <field name="total_revenue"           type="measure" string="Revenue"/>
                <field name="total_fuel_cost"         type="measure" string="Fuel Cost"/>
                <field name="total_maintenance_cost"  type="measure" string="Maintenance"/>
                <field name="total_operational_cost"  type="measure" string="Total Op. Cost"/>
                <field name="vehicle_roi"             type="measure" string="ROI (%)"/>
                <field name="fuel_efficiency"         type="measure" string="km/L"/>
                <field name="trip_count"              type="measure" string="Trips"/>
                <field name="acquisition_cost"        type="measure" string="Acquisition Cost"/>
            </pivot>
        </field>
    </record>

    <record id="view_ff_vehicle_graph_efficiency" model="ir.ui.view">
        <field name="name">ff.vehicle.graph.efficiency</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Fuel Efficiency Trend (km/L)" type="line" sample="1">
                <field name="name" type="row"/>
                <field name="fuel_efficiency" type="measure" string="km/L"/>
            </graph>
        </field>
    </record>

    <record id="view_ff_vehicle_graph_roi" model="ir.ui.view">
        <field name="name">ff.vehicle.graph.roi</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Top 5 Efficient Vehicles — ROI &amp; Cost" type="bar" sample="1" order="desc">
                <field name="name" type="row"/>
                <field name="vehicle_roi" type="measure" string="ROI (%)"/>
                <field name="total_operational_cost" type="measure" string="Op. Cost"/>
                <field name="total_revenue" type="measure" string="Revenue"/>
            </graph>
        </field>
    </record>


    <record id="view_ff_trip_pivot_monthly" model="ir.ui.view">
        <field name="name">ff.trip.pivot.monthly</field>
        <field name="model">ff.trip</field>
        <field name="arch" type="xml">
            <pivot string="Financial Summary of Month" sample="1">
                <field name="scheduled_date" interval="month" type="row" string="Month"/>
                <field name="fleet_type" type="col" string="Fleet Type"/>
                <field name="revenue"       type="measure" string="Revenue"/>
                <field name="cargo_weight"  type="measure" string="Cargo (kg)"/>
                <field name="distance_km"   type="measure" string="Distance (km)"/>
            </pivot>
        </field>
    </record>

    <record id="view_ff_trip_graph_monthly" model="ir.ui.view">
        <field name="name">ff.trip.graph.monthly</field>
        <field name="model">ff.trip</field>
        <field name="arch" type="xml">
            <graph string="Monthly Revenue &amp; Trip Volume" type="bar" sample="1">
                <field name="scheduled_date" interval="month" type="row" string="Month"/>
                <field name="revenue"  type="measure" string="Revenue"/>
            </graph>
        </field>
    </record>


    <record id="view_ff_expense_pivot" model="ir.ui.view">
        <field name="name">ff.expense.pivot</field>
        <field name="model">ff.fuel.expense</field>
        <field name="arch" type="xml">
            <pivot string="Fuel &amp; Expense Breakdown" sample="1">
                <field name="date" interval="month" type="col" string="Month"/>
                <field name="vehicle_id" type="row" string="Vehicle"/>
                <field name="cost"          type="measure" string="Total Cost"/>
                <field name="fuel_cost"     type="measure" string="Fuel Cost"/>
                <field name="misc_expense"  type="measure" string="Misc. Expense"/>
                <field name="liters"        type="measure" string="Liters"/>
                <field name="distance_km"   type="measure" string="Distance (km)"/>
            </pivot>
        </field>
    </record>

    <record id="view_ff_expense_graph" model="ir.ui.view">
        <field name="name">ff.expense.graph</field>
        <field name="model">ff.fuel.expense</field>
        <field name="arch" type="xml">
            <graph string="Fuel &amp; Operational Expense by Vehicle" type="bar" sample="1">
                <field name="vehicle_id"    type="row"/>
                <field name="expense_type"  type="col"/>
                <field name="cost"          type="measure" string="Cost"/>
            </graph>
        </field>
    </record>


    <record id="action_ff_fleet_analytics" model="ir.actions.act_window">
        <field name="name">Fleet Analytics — ROI &amp; Efficiency</field>
        <field name="res_model">ff.vehicle</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_ff_vehicle_graph_efficiency')}),
            (0,0,{'view_mode':'pivot','view_id':ref('view_ff_vehicle_pivot')}),
            (0,0,{'view_mode':'list'})]"/>
    </record>

    <record id="action_ff_financial_summary" model="ir.actions.act_window">
        <field name="name">Financial Summary of Month</field>
        <field name="res_model">ff.trip</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'pivot','view_id':ref('view_ff_trip_pivot_monthly')}),
            (0,0,{'view_mode':'graph','view_id':ref('view_ff_trip_graph_monthly')}),
            (0,0,{'view_mode':'list'})]"/>
    </record>

    <record id="action_ff_expense_analytics" model="ir.actions.act_window">
        <field name="name">Fuel &amp; Expense Analytics</field>
        <field name="res_model">ff.fuel.expense</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_ff_expense_graph')}),
            (0,0,{'view_mode':'pivot','view_id':ref('view_ff_expense_pivot')}),
            (0,0,{'view_mode':'list'})]"/>
    </record>

    <record id="action_ff_top_efficient" model="ir.actions.act_window">
        <field name="name">Top Efficient Vehicles</field>
        <field name="res_model">ff.vehicle</field>
        <field name="view_mode">graph,list</field>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_mode':'graph','view_id':ref('view_ff_vehicle_graph_roi')}),
            (0,0,{'view_mode':'list'})]"/>
    </record>

</odoo>
