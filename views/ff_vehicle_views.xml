<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         PAGE 3: VEHICLE REGISTRY (Asset Management)
         Wireframe: List table with ID, Plate, Model, Type, Capacity,
                    Odometer, Status, Actions
                    Side panel: New Vehicle Registration form
    ══════════════════════════════════════════════════════════════ -->

    <!-- LIST VIEW — matches wireframe table columns exactly -->
    <record id="view_ff_vehicle_list" model="ir.ui.view">
        <field name="name">ff.vehicle.list</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicle Registry"
                  decoration-muted="state == 'retired'"
                  decoration-warning="state == 'in_shop'"
                  decoration-info="state == 'on_trip'"
                  edit="1"
                  sample="1">
                <!-- Columns matching wireframe: ID | Plate | Model | Type | Capacity | Odometer | Status | Actions -->
                <field name="name" string="Name / Model"/>
                <field name="license_plate" string="License Plate"/>
                <field name="vehicle_type" string="Type"/>
                <field name="max_load_capacity" string="Capacity (kg)" widget="float" digits="[16,0]"/>
                <field name="odometer" string="Odometer (km)" widget="float" digits="[16,0]"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'on_trip'"
                       decoration-warning="state == 'in_shop'"
                       decoration-danger="state == 'retired'"/>
                <field name="region" string="Region" optional="show"/>
                <field name="fuel_efficiency" string="km/L" optional="show"/>
                <!-- Action buttons matching wireframe "Actions" column -->
                <button name="action_set_available" type="object"
                        string="Activate" class="btn-sm btn-success"
                        invisible="state == 'available'"/>
                <button name="action_set_retired" type="object"
                        string="Retire" class="btn-sm btn-danger"
                        invisible="state == 'retired'"
                        confirm="Retire this vehicle permanently?"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW — New Vehicle Registration (matches wireframe side form) -->
    <record id="view_ff_vehicle_form" model="ir.ui.view">
        <field name="name">ff.vehicle.form</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_set_available" type="object"
                            string="Set Available" class="btn-primary"
                            invisible="state == 'available'"/>
                    <button name="action_set_retired" type="object"
                            string="Retire Vehicle" class="btn-danger"
                            invisible="state == 'retired'"
                            confirm="Retire this vehicle? It will be removed from dispatch pool."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,on_trip,in_shop,retired"/>
                </header>
                <sheet>
                    <!-- Stat buttons — smart buttons bar -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trips" type="object"
                                class="oe_stat_button" icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                        <button name="action_view_trips" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Service Logs</span>
                            </div>
                        </button>
                    </div>

                    <!-- Out-of-service warning banner -->
                    <div class="alert alert-warning o_form_fields_group_separator" role="alert"
                         invisible="not out_of_service">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        This vehicle is <strong>Out of Service (Retired)</strong> and will not appear in the dispatcher.
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Van-05 or Toyota HiAce"/>
                        </h1>
                    </div>

                    <!-- New Vehicle Registration — matching wireframe form fields -->
                    <group>
                        <group string="Vehicle Details">
                            <field name="license_plate" placeholder="e.g. MH-12-AB-1234"/>
                            <field name="vehicle_type"/>
                            <field name="region" placeholder="e.g. Mumbai North"/>
                            <field name="max_load_capacity" string="Max Payload (kg)"/>
                            <field name="odometer" string="Initial Odometer (km)"/>
                            <field name="out_of_service" widget="boolean_toggle"/>
                        </group>
                        <group string="Acquisition Info">
                            <field name="acquisition_cost" widget="monetary"/>
                            <field name="acquisition_date"/>
                        </group>
                    </group>

                    <!-- Financial Summary Section -->
                    <group string="Operational Cost Summary" col="4">
                        <field name="total_fuel_cost" widget="monetary" string="Fuel Cost" readonly="1"/>
                        <field name="total_maintenance_cost" widget="monetary" string="Maintenance" readonly="1"/>
                        <field name="total_operational_cost" widget="monetary" string="Total Op. Cost" readonly="1"/>
                        <field name="vehicle_roi" string="ROI (%)" readonly="1"/>
                    </group>
                    <group col="2">
                        <field name="fuel_efficiency" string="Avg km/L" readonly="1"/>
                        <field name="total_revenue" widget="monetary" readonly="1"/>
                    </group>

                    <!-- Tabbed sub-sections -->
                    <notebook>
                        <page string="Trip History" name="trips">
                            <field name="trip_ids" readonly="1">
                                <list decoration-success="state=='completed'"
                                      decoration-danger="state=='cancelled'">
                                    <field name="name"/>
                                    <field name="driver_id"/>
                                    <field name="origin"/>
                                    <field name="destination"/>
                                    <field name="scheduled_date"/>
                                    <field name="cargo_weight" string="Cargo (kg)"/>
                                    <field name="revenue"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='completed'"
                                           decoration-info="state=='dispatched'"
                                           decoration-danger="state=='cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Service Logs" name="maintenance">
                            <field name="maintenance_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="service_type"/>
                                    <field name="service_date"/>
                                    <field name="vendor"/>
                                    <field name="cost" widget="monetary"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state=='open'"
                                           decoration-success="state=='done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fuel &amp; Expenses" name="expenses">
                            <field name="fuel_expense_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="expense_type"/>
                                    <field name="liters"/>
                                    <field name="cost" widget="monetary"/>
                                    <field name="distance_km"/>
                                    <field name="station"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW — Vehicle cards grouped by status -->
    <record id="view_ff_vehicle_kanban" model="ir.ui.view">
        <field name="name">ff.vehicle.kanban</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1"
                    class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="vehicle_type"/>
                <field name="license_plate"/>
                <field name="max_load_capacity"/>
                <field name="odometer"/>
                <field name="total_operational_cost"/>
                <field name="fuel_efficiency"/>
                <templates>
                    <t t-name="card" class="ff_vehicle_card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <field name="state" widget="label_selection"
                                   options="{'classes': {
                                     'available': 'success',
                                     'on_trip':   'info',
                                     'in_shop':   'warning',
                                     'retired':   'danger'
                                   }}"/>
                        </div>
                        <ul class="list-unstyled small mt-2 mb-0">
                            <li><i class="fa fa-id-card fa-fw text-muted"/><field name="license_plate"/></li>
                            <li><i class="fa fa-truck fa-fw text-muted"/><field name="vehicle_type"/></li>
                            <li><i class="fa fa-weight-hanging fa-fw text-muted"/><field name="max_load_capacity" digits="[16,0]"/> kg max</li>
                            <li><i class="fa fa-road fa-fw text-muted"/><field name="odometer" digits="[16,0]"/> km</li>
                        </ul>
                        <div class="d-flex justify-content-between mt-2 small text-muted">
                            <span>💰 <field name="total_operational_cost" widget="monetary"/></span>
                            <span>⛽ <field name="fuel_efficiency"/> km/L</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_ff_vehicle_search" model="ir.ui.view">
        <field name="name">ff.vehicle.search</field>
        <field name="model">ff.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Name / Model"/>
                <field name="license_plate"/>
                <field name="region"/>
                <separator/>
                <!-- Status filters matching wireframe filter pills -->
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="On Trip"   name="on_trip"   domain="[('state','=','on_trip')]"/>
                <filter string="In Shop"   name="in_shop"   domain="[('state','=','in_shop')]"/>
                <filter string="Retired"   name="retired"   domain="[('state','=','retired')]"/>
                <separator/>
                <!-- Type filters matching wireframe: Truck/Van/Bike -->
                <filter string="Trucks" name="truck" domain="[('vehicle_type','=','truck')]"/>
                <filter string="Vans"   name="van"   domain="[('vehicle_type','=','van')]"/>
                <filter string="Bikes"  name="bike"  domain="[('vehicle_type','=','bike')]"/>
                <group expand="1" string="Group By">
                    <filter string="Status"  name="grp_state"  context="{'group_by':'state'}"/>
                    <filter string="Type"    name="grp_type"   context="{'group_by':'vehicle_type'}"/>
                    <filter string="Region"  name="grp_region" context="{'group_by':'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_ff_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle Registry</field>
        <field name="res_model">ff.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ff_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first vehicle!</p>
            <p>Register vehicles to start managing your fleet lifecycle.</p>
        </field>
    </record>

</odoo>
