<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Analytics List -->
    <record id="view_fleetflow_analytics_list" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.analytics.list</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicle Analytics">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type" widget="badge"/>
                <field name="trip_count"/>
                <field name="total_km" sum="Total KM"/>
                <field name="total_fuel_liters" sum="Total Fuel (L)"/>
                <field name="fuel_efficiency"/>
                <field name="total_fuel_cost" sum="Total Fuel Cost"/>
                <field name="total_maintenance_cost" sum="Total Maintenance Cost"/>
                <field name="total_operational_cost" sum="Total Op. Cost"/>
                <field name="total_revenue" sum="Total Revenue"/>
                <field name="vehicle_roi" string="ROI (%)"/>
                <field name="acquisition_cost" sum="Total Acquisition Cost"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Analytics Graph View -->
    <record id="view_fleetflow_analytics_graph" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.analytics.graph</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Fleet Analytics" type="bar">
                <field name="name"/>
                <field name="total_operational_cost" type="measure" string="Op. Cost"/>
                <field name="total_revenue" type="measure" string="Revenue"/>
                <field name="fuel_efficiency" type="measure" string="Fuel Efficiency (km/L)"/>
                <field name="vehicle_roi" type="measure" string="ROI (%)"/>
            </graph>
        </field>
    </record>

    <!-- Vehicle Analytics Pivot View -->
    <record id="view_fleetflow_analytics_pivot" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.analytics.pivot</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Fleet Cost Analysis">
                <field name="vehicle_type" type="row"/>
                <field name="total_fuel_cost" type="measure"/>
                <field name="total_maintenance_cost" type="measure"/>
                <field name="total_operational_cost" type="measure"/>
                <field name="total_revenue" type="measure"/>
                <field name="fuel_efficiency" type="measure"/>
                <field name="vehicle_roi" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Analytics Action -->
    <record id="action_fleetflow_analytics" model="ir.actions.act_window">
        <field name="name">Fleet Analytics &amp; Reports</field>
        <field name="res_model">fleetflow.vehicle</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_type': 1}</field>
    </record>

    <!-- Trip Analytics Graph -->
    <record id="view_fleetflow_trip_graph" model="ir.ui.view">
        <field name="name">fleetflow.trip.graph</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <graph string="Trip Analytics" type="bar">
                <field name="state"/>
                <field name="revenue" type="measure" string="Revenue"/>
                <field name="distance_km" type="measure" string="Distance (km)"/>
                <field name="cargo_weight" type="measure" string="Cargo Weight (kg)"/>
            </graph>
        </field>
    </record>

    <!-- Trip Analytics Pivot -->
    <record id="view_fleetflow_trip_pivot" model="ir.ui.view">
        <field name="name">fleetflow.trip.pivot</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <pivot string="Trip Analysis">
                <field name="vehicle_id" type="row"/>
                <field name="driver_id" type="col"/>
                <field name="revenue" type="measure"/>
                <field name="distance_km" type="measure"/>
                <field name="cargo_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Trip Analytics Action -->
    <record id="action_fleetflow_trip_analytics" model="ir.actions.act_window">
        <field name="name">Trip Reports</field>
        <field name="res_model">fleetflow.trip</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state','=','completed')]</field>
    </record>
</odoo>
