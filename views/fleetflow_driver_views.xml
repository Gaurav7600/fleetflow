<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Driver Form View -->
    <record id="view_fleetflow_driver_form" model="ir.ui.view">
        <field name="name">fleetflow.driver.form</field>
        <field name="model">fleetflow.driver</field>
        <field name="arch" type="xml">
            <form string="Driver Profile">
                <header>
                    <button name="action_set_on_duty" string="Set On Duty" type="object"
                        class="btn-success" invisible="status == 'on_duty'"/>
                    <button name="action_set_off_duty" string="Set Off Duty" type="object"
                        class="btn-secondary" invisible="status == 'off_duty'"/>
                    <button name="action_suspend" string="Suspend" type="object"
                        class="btn-danger" invisible="status == 'suspended'"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="off_duty,on_duty,on_trip,suspended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Driver Name"/></h1>
                    </div>
                    <group>
                        <group string="Personal Info">
                            <field name="employee_id"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Status &amp; Performance">
                            <field name="status" widget="badge"
                                decoration-success="status == 'on_duty'"
                                decoration-warning="status == 'on_trip'"
                                decoration-danger="status == 'suspended'"
                                decoration-muted="status == 'off_duty'"/>
                            <field name="safety_score" widget="progressbar"
                                options="{'editable': true, 'max_value': 100, 'title': 'Safety Score'}"/>
                            <field name="completion_rate" widget="progressbar"
                                options="{'editable': false, 'max_value': 100, 'title': 'Completion Rate'}"/>
                            <field name="total_trips"/>
                            <field name="completed_trips"/>
                        </group>
                    </group>
                    <group string="License Information">
                        <group>
                            <field name="license_number"/>
                            <field name="license_category"/>
                            <field name="license_expiry"/>
                        </group>
                        <group>
                            <field name="license_valid" widget="boolean_toggle"/>
                            <field name="days_to_expiry"
                                decoration-danger="days_to_expiry &lt;= 30"
                                decoration-warning="days_to_expiry &lt;= 90"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trip History" name="trips">
                            <field name="trip_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vehicle_id"/>
                                    <field name="origin"/>
                                    <field name="destination"/>
                                    <field name="scheduled_date"/>
                                    <field name="cargo_weight"/>
                                    <field name="distance_km"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'completed'"
                                        decoration-warning="state == 'dispatched'"
                                        decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Driver List View -->
    <record id="view_fleetflow_driver_list" model="ir.ui.view">
        <field name="name">fleetflow.driver.list</field>
        <field name="model">fleetflow.driver</field>
        <field name="arch" type="xml">
            <list string="Driver Profiles"
                decoration-danger="not license_valid or status == 'suspended'"
                decoration-warning="days_to_expiry &lt;= 30 and days_to_expiry &gt;= 0">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="phone"/>
                <field name="license_number"/>
                <field name="license_category" widget="badge"/>
                <field name="license_expiry"/>
                <field name="license_valid" widget="boolean" readonly="1"/>
                <field name="days_to_expiry"
                    decoration-danger="days_to_expiry &lt;= 0"
                    decoration-warning="days_to_expiry &lt;= 30"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'on_duty'"
                    decoration-warning="status == 'on_trip'"
                    decoration-danger="status == 'suspended'"
                    decoration-muted="status == 'off_duty'"/>
                <field name="safety_score"/>
                <field name="completion_rate" string="Completion %"/>
            </list>
        </field>
    </record>

    <!-- Driver Search View -->
    <record id="view_fleetflow_driver_search" model="ir.ui.view">
        <field name="name">fleetflow.driver.search</field>
        <field name="model">fleetflow.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="license_number"/>
                <filter name="on_duty" string="On Duty" domain="[('status','=','on_duty')]"/>
                <filter name="available" string="Available" domain="[('status','in',['on_duty','off_duty']),('license_valid','=',True)]"/>
                <filter name="suspended" string="Suspended" domain="[('status','=','suspended')]"/>
                <filter name="license_expired" string="License Expired" domain="[('license_valid','=',False)]"/>
                <filter name="expiry_soon" string="License Expiring Soon (30 days)"
                    domain="[('days_to_expiry','&lt;=',30),('days_to_expiry','&gt;=',0)]"/>
                <separator/>
                <filter name="truck_license" string="Truck License" domain="[('license_category','in',['truck','all'])]"/>
                <filter name="van_license" string="Van License" domain="[('license_category','in',['van','all'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_category" string="License Category" context="{'group_by': 'license_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Driver Action -->
    <record id="action_fleetflow_driver" model="ir.actions.act_window">
        <field name="name">Driver Profiles</field>
        <field name="res_model">fleetflow.driver</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fleetflow_driver_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first driver!</p>
            <p>Track driver licenses, compliance, and performance.</p>
        </field>
    </record>
</odoo>
