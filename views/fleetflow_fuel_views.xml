<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuel Form View -->
    <record id="view_fleetflow_fuel_form" model="ir.ui.view">
        <field name="name">fleetflow.fuel.form</field>
        <field name="model">fleetflow.fuel</field>
        <field name="arch" type="xml">
            <form string="Fuel &amp; Expense Log">
                <sheet>
                    <group>
                        <group string="Log Details">
                            <field name="log_type"/>
                            <field name="vehicle_id"/>
                            <field name="trip_id"
                                domain="[('vehicle_id','=',vehicle_id),('state','in',['dispatched','completed'])]"/>
                            <field name="date"/>
                        </group>
                        <group string="Fuel (if applicable)" invisible="log_type != 'fuel'">
                            <field name="liters"/>
                            <field name="cost_per_liter"/>
                            <field name="cost"/>
                            <field name="fuel_station"/>
                            <field name="odometer"/>
                        </group>
                        <group string="Expense" invisible="log_type != 'expense'">
                            <field name="expense_description"/>
                            <field name="manual_cost"/>
                            <field name="cost" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Fuel List View -->
    <record id="view_fleetflow_fuel_list" model="ir.ui.view">
        <field name="name">fleetflow.fuel.list</field>
        <field name="model">fleetflow.fuel</field>
        <field name="arch" type="xml">
            <list string="Fuel &amp; Expense Logs">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="log_type" widget="badge"/>
                <field name="liters" sum="Total Liters"/>
                <field name="cost" sum="Total Cost"/>
                <field name="expense_description"/>
                <field name="odometer"/>
                <field name="fuel_station"/>
            </list>
        </field>
    </record>

    <!-- Fuel Search View -->
    <record id="view_fleetflow_fuel_search" model="ir.ui.view">
        <field name="name">fleetflow.fuel.search</field>
        <field name="model">fleetflow.fuel</field>
        <field name="arch" type="xml">
            <search string="Search Fuel &amp; Expenses">
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <filter name="fuel" string="Fuel Logs" domain="[('log_type','=','fuel')]"/>
                <filter name="expense" string="Expenses" domain="[('log_type','=','expense')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Log Type" context="{'group_by': 'log_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fuel Action -->
    <record id="action_fleetflow_fuel" model="ir.actions.act_window">
        <field name="name">Fuel &amp; Expense Logs</field>
        <field name="res_model">fleetflow.fuel</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fleetflow_fuel_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first fuel entry!</p>
            <p>Track fuel costs and expenses per vehicle and trip.</p>
        </field>
    </record>
</odoo>
