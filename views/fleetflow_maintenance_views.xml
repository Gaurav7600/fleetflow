<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Form View -->
    <record id="view_fleetflow_maintenance_form" model="ir.ui.view">
        <field name="name">fleetflow.maintenance.form</field>
        <field name="model">fleetflow.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance / Service Log">
                <header>
                    <button name="action_complete" string="Mark Complete" type="object"
                        class="btn-success" invisible="state == 'done'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                        invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Service Details">
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="maintenance_type"/>
                            <field name="date"/>
                        </group>
                        <group string="Details">
                            <field name="cost"/>
                            <field name="odometer_at_service"/>
                            <field name="technician"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Maintenance List View -->
    <record id="view_fleetflow_maintenance_list" model="ir.ui.view">
        <field name="name">fleetflow.maintenance.list</field>
        <field name="model">fleetflow.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Logs"
                decoration-warning="state == 'open'"
                decoration-success="state == 'done'">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="maintenance_type" widget="badge"/>
                <field name="cost" sum="Total Cost"/>
                <field name="odometer_at_service"/>
                <field name="technician"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'open'"
                    decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Maintenance Search View -->
    <record id="view_fleetflow_maintenance_search" model="ir.ui.view">
        <field name="name">fleetflow.maintenance.search</field>
        <field name="model">fleetflow.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="maintenance_type"/>
                <filter name="open" string="In Shop (Open)" domain="[('state','=','open')]"/>
                <filter name="done" string="Completed" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Maintenance Action -->
    <record id="action_fleetflow_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance &amp; Service Logs</field>
        <field name="res_model">fleetflow.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fleetflow_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log your first service!</p>
            <p>Track vehicle maintenance. Logging a service automatically marks the vehicle as "In Shop".</p>
        </field>
    </record>
</odoo>
