<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Form View -->
    <record id="view_fleetflow_vehicle_form" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.form</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle Registry">
                <header>
                    <button name="action_set_available" string="Set Available" type="object"
                        class="btn-success" invisible="status == 'available'"/>
                    <button name="action_set_retired" string="Retire Vehicle" type="object"
                        class="btn-danger" invisible="status == 'retired'"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="available,on_trip,in_shop,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_trips"
                            icon="fa-road">
                            <field name="trip_count" widget="statinfo" string="Trips"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_maintenance"
                            icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Vehicle Name / Model"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Vehicle Details">
                            <field name="license_plate"/>
                            <field name="vehicle_type"/>
                            <field name="region"/>
                            <field name="max_capacity"/>
                            <field name="odometer"/>
                            <field name="acquisition_cost"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"
                                decoration-success="status == 'available'"
                                decoration-warning="status == 'in_shop'"
                                decoration-danger="status == 'retired'"
                                decoration-info="status == 'on_trip'"/>
                            <field name="out_of_service"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Financial Summary" name="financials">
                            <group>
                                <group string="Costs">
                                    <field name="total_fuel_cost"/>
                                    <field name="total_maintenance_cost"/>
                                    <field name="total_operational_cost"/>
                                </group>
                                <group string="Performance">
                                    <field name="total_km"/>
                                    <field name="total_fuel_liters"/>
                                    <field name="fuel_efficiency"/>
                                    <field name="total_revenue"/>
                                    <field name="vehicle_roi" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                        <page string="Trips" name="trips">
                            <field name="trip_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="origin"/>
                                    <field name="destination"/>
                                    <field name="driver_id"/>
                                    <field name="cargo_weight"/>
                                    <field name="scheduled_date"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'completed'"
                                        decoration-warning="state == 'dispatched'"
                                        decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintenance" name="maintenance">
                            <field name="maintenance_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="maintenance_type"/>
                                    <field name="cost"/>
                                    <field name="state" widget="badge"
                                        decoration-warning="state == 'open'"
                                        decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fuel &amp; Expenses" name="fuel">
                            <field name="fuel_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="log_type"/>
                                    <field name="liters"/>
                                    <field name="cost"/>
                                    <field name="trip_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle List View -->
    <record id="view_fleetflow_vehicle_list" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.list</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicle Registry" decoration-muted="status == 'retired'"
                decoration-danger="status == 'in_shop'" decoration-success="status == 'available'">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type" widget="badge"/>
                <field name="region"/>
                <field name="max_capacity"/>
                <field name="odometer"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'available'"
                    decoration-warning="status == 'in_shop'"
                    decoration-danger="status == 'retired'"
                    decoration-info="status == 'on_trip'"/>
                <field name="total_operational_cost" sum="Total Cost"/>
                <field name="fuel_efficiency"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Kanban View -->
    <record id="view_fleetflow_vehicle_kanban" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.kanban</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="status"/>
                <field name="max_capacity"/>
                <field name="total_operational_cost"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="license_plate"/></div>
                            <div>
                                <span class="badge rounded-pill bg-info"><field name="vehicle_type"/></span>
                                <span class="badge rounded-pill bg-secondary"><field name="region"/></span>
                            </div>
                            <div>Capacity: <field name="max_capacity"/> kg</div>
                            <div>Odometer: <field name="odometer"/> km</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_fleetflow_vehicle_search" model="ir.ui.view">
        <field name="name">fleetflow.vehicle.search</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="region"/>
                <filter name="available" string="Available" domain="[('status','=','available')]"/>
                <filter name="on_trip" string="On Trip" domain="[('status','=','on_trip')]"/>
                <filter name="in_shop" string="In Shop" domain="[('status','=','in_shop')]"/>
                <filter name="retired" string="Retired" domain="[('status','=','retired')]"/>
                <separator/>
                <filter name="truck" string="Trucks" domain="[('vehicle_type','=','truck')]"/>
                <filter name="van" string="Vans" domain="[('vehicle_type','=','van')]"/>
                <filter name="bike" string="Bikes" domain="[('vehicle_type','=','bike')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Vehicle Type" context="{'group_by': 'vehicle_type'}"/>
                    <filter name="group_region" string="Region" context="{'group_by': 'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vehicle Action -->
    <record id="action_fleetflow_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle Registry</field>
        <field name="res_model">fleetflow.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_fleetflow_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first vehicle!
            </p>
            <p>Add vehicles to track their lifecycle, capacity, and operational costs.</p>
        </field>
    </record>
</odoo>