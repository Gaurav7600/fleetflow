<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Command Center Dashboard -->
    <record id="view_fleetflow_dashboard" model="ir.ui.view">
        <field name="name">fleetflow.dashboard</field>
        <field name="model">fleetflow.vehicle</field>
        <field name="arch" type="xml">
            <search string="Fleet Dashboard">
                <filter name="available" string="Available" domain="[('status','=','available')]"/>
                <filter name="on_trip" string="On Trip" domain="[('status','=','on_trip')]"/>
                <filter name="in_shop" string="In Shop" domain="[('status','=','in_shop')]"/>
                <separator/>
                <filter name="truck" string="Trucks" domain="[('vehicle_type','=','truck')]"/>
                <filter name="van" string="Vans" domain="[('vehicle_type','=','van')]"/>
                <filter name="bike" string="Bikes" domain="[('vehicle_type','=','bike')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_region" string="Region" context="{'group_by': 'region'}"/>
                    <filter name="group_type" string="Vehicle Type" context="{'group_by': 'vehicle_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_fleetflow_dashboard" model="ir.actions.act_window">
        <field name="name">Command Center</field>
        <field name="res_model">fleetflow.vehicle</field>
        <field name="view_mode">kanban,list</field>
        <field name="search_view_id" ref="view_fleetflow_dashboard"/>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to FleetFlow Command Center!
            </p>
            <p>Start by registering your vehicles and drivers.</p>
        </field>
    </record>
</odoo>
