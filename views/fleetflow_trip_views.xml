<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip Form View -->
    <record id="view_fleetflow_trip_form" model="ir.ui.view">
        <field name="name">fleetflow.trip.form</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <form string="Trip">
                <header>
                    <button name="action_dispatch" string="Dispatch" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Mark Complete" type="object"
                        class="btn-success" invisible="state != 'dispatched'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        class="btn-danger" invisible="state in ('completed','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,dispatched,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="origin"/>
                            <field name="destination"/>
                            <field name="scheduled_date"/>
                            <field name="dispatched_date" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                        </group>
                        <group string="Assignment">
                            <field name="vehicle_id"
                                domain="[('status','in',['available']),('out_of_service','=',False)]"/>
                            <field name="driver_id"
                                domain="[('status','in',['on_duty','off_duty']),('license_valid','=',True)]"/>
                            <field name="cargo_weight"/>
                            <field name="revenue"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cargo">
                            <field name="cargo_description"/>
                        </group>
                        <group string="Odometer">
                            <field name="odometer_start"/>
                            <field name="odometer_end" invisible="state == 'draft'"/>
                            <field name="distance_km" readonly="1" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Fuel &amp; Expenses" name="fuel" invisible="state == 'draft'">
                            <field name="fuel_log_ids" options="{'no_create': True}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="log_type"/>
                                    <field name="liters" invisible="log_type != 'fuel'"/>
                                    <field name="cost_per_liter" invisible="log_type != 'fuel'"/>
                                    <field name="cost"/>
                                    <field name="fuel_station" invisible="log_type != 'fuel'"/>
                                    <field name="expense_description" invisible="log_type != 'expense'"/>
                                    <field name="odometer"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Trip List View -->
    <record id="view_fleetflow_trip_list" model="ir.ui.view">
        <field name="name">fleetflow.trip.list</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <list string="Trips"
                decoration-success="state == 'completed'"
                decoration-info="state == 'dispatched'"
                decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="cargo_weight"/>
                <field name="scheduled_date"/>
                <field name="distance_km"/>
                <field name="revenue" sum="Total Revenue"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'completed'"
                    decoration-warning="state == 'dispatched'"
                    decoration-muted="state in ('draft','cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Trip Kanban View -->
    <record id="view_fleetflow_trip_kanban" model="ir.ui.view">
        <field name="name">fleetflow.trip.kanban</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="cargo_weight"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div><field name="origin"/> → <field name="destination"/></div>
                            <div class="text-muted">
                                <i class="fa fa-truck"/> <field name="vehicle_id"/>
                                &amp;nbsp;|&amp;nbsp;
                                <i class="fa fa-user"/> <field name="driver_id"/>
                            </div>
                            <div>Cargo: <field name="cargo_weight"/> kg</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Trip Search View -->
    <record id="view_fleetflow_trip_search" model="ir.ui.view">
        <field name="name">fleetflow.trip.search</field>
        <field name="model">fleetflow.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="dispatched" string="Dispatched" domain="[('state','=','dispatched')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Trip Action -->
    <record id="action_fleetflow_trip" model="ir.actions.act_window">
        <field name="name">Trip Dispatcher</field>
        <field name="res_model">fleetflow.trip</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_fleetflow_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first trip!</p>
            <p>Assign vehicles and drivers to dispatch shipments.</p>
        </field>
    </record>
</odoo>
